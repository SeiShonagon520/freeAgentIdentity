# Customer Portal API 本地开发模板
# 复制为 .env 后填写，所有值都必须在部署前替换。

PORTAL_APP_NAME=Customer Portal API
PORTAL_JWT_SECRET=
PORTAL_ADMIN_USERNAME=
PORTAL_ADMIN_PASSWORD=
PORTAL_ADMIN_EMAIL=
PORTAL_ACCESS_TOKEN_TTL_SECONDS=900
PORTAL_REFRESH_TOKEN_TTL_SECONDS=86400
# 生产环境填写明确的 HTTPS 来源，禁止使用通配符 *。
PORTAL_CORS_ORIGINS=http://127.0.0.1:5173
PORTAL_START_SOLVER=false
